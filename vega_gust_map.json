{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "COVID-19 Active Cases (10 Oct 2020)",
  "width": 800,
  "height": 400,
  "projection": {"type": "equalEarth"},
  "data": {
    "url": "STE_2016_AUST.topojson",
    "format": {"type": "topojson", "feature": "STE_2016_AUST"}
  },
  "transform": [
    {
      "lookup": "properties.NAME",
      "from": {
        "data": {
          "url": "Gusty_Days.csv"
        },
        "key": "State",
        "fields": ["gustDays"]
      }
    },
    {"calculate": "datum.gustDays", "as": "Gusty Days"}
  ],
  "mark": {"type": "geoshape"},
  "encoding": {
    "color": {
      "field": "Gusty Days",
      "type": "quantitative"
      
    },
    "tooltip": [
      {"field": "properties.NAME", "type": "nominal", "title": "State"},
      {"field": "gustDays", "type": "quantitative"}
    ]
  }
}